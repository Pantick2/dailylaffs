PORT=3000
SITE_URL=https://example.com
OPENAI_API_KEY=sk-...
USE_GCS_STORAGE=true
GCS_BUCKET_NAME=
GCS_PUBLIC_BASE_URL=

# Internal Facebook/Instagram posting from app (optional, default disabled)
ENABLE_INTERNAL_SOCIAL_POSTS=false

# Make.com webhook for external distribution (recommended)
MAKE_WEBHOOK_URL=

# Facebook Page auto-post (optional, used only if ENABLE_INTERNAL_SOCIAL_POSTS=true)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram Business auto-post (optional, used only if ENABLE_INTERNAL_SOCIAL_POSTS=true)
INSTAGRAM_IG_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
